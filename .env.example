# Copy to .env.local for local development (or run `vercel env pull`).
# Never commit real values — this repository is public.

# Claude API key (server-side only)
ANTHROPIC_API_KEY=

# Shared password for the app and the secret used to sign session cookies (min. 32 chars)
APP_PASSWORD=
SESSION_SECRET=

# mock = fixtures with simulated streaming (no API costs), live = real API calls
AI_MODE=mock

# Model for product search and alternatives (default: claude-haiku-5-5)
PRODUCT_SEARCH_MODEL=claude-haiku-5-5

# Image model on the Vercel AI Gateway (default: google/gemini-nano-banana-2.1)
IMAGE_MODEL=google/gemini-nano-banana-2.1

# Optional: AI Gateway key for local use (deployments authenticate via OIDC automatically)
AI_GATEWAY_API_KEY=

# Optional Instagram booster — only YOUR OWN Meta app / Instagram professional account.
# oEmbed (caption/author): app or client token of a Meta app with "oEmbed Read"
META_OEMBED_TOKEN=
# Business Discovery (real images of posts from creator/business accounts):
# user token + user ID of your own Instagram professional account via Facebook Login or Unified Login
META_IG_USER_TOKEN=
META_IG_USER_ID=
# ISO date when META_IG_USER_TOKEN expires (the app warns 7 days before)
META_IG_USER_TOKEN_EXPIRES=
